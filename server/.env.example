# 服务端口
PORT=8787
NODE_ENV=production

# 首次启动且数据库中没有管理员时，用以下变量创建首个管理员。
# 创建完成并首次登录修改密码后，请从运行环境中删除这三个变量。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_DISPLAY_NAME=NavPilot Admin
BOOTSTRAP_ADMIN_PASSWORD=请替换为至少10位的随机强密码

# AI 服务：后台“系统设置”覆盖 > 环境变量 > 内置默认值
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# 状态探测
AUTO_CHECK_ENABLED=true
CHECK_INTERVAL_MINUTES=5
CHECK_TIMEOUT_MS=5000

# 当前版本不再使用 ADMIN_TOKEN，也不接受 x-user-id/x-user-name 身份头。
# 登录使用服务器端 SQLite 会话和 HttpOnly Cookie；生产环境必须使用 HTTPS。
