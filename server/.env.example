# 服务端口
PORT=8787
NODE_ENV=production

# 首次启动且数据库中没有管理员时，用以下变量创建首个管理员。
# 创建完成并首次登录修改密码后，请从运行环境中删除这三个变量。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_DISPLAY_NAME=NavPilot Admin
BOOTSTRAP_ADMIN_PASSWORD=请替换为至少10位的随机强密码

# AI 服务：后台“系统设置”覆盖 > 环境变量 > 内置默认值
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# 可选：固定用于加密后台模型密钥的 32 字节 Base64 或 64 位十六进制密钥。
# 留空时会在数据目录自动生成 .navpilot-secret；请与数据库分别备份。
NAVPILOT_SECRET_KEY=
# 主动整理报告调度，默认每周一 UTC 09:00。
AI_REPORT_CRON="0 9 * * 1"

# 状态探测
AUTO_CHECK_ENABLED=true
CHECK_INTERVAL_MINUTES=5
CHECK_TIMEOUT_MS=5000
# 五分钟级原始探测明细保留天数；每日汇总和故障事件长期保留。
HEALTH_RAW_RETENTION_DAYS=30
# 每日清理过期明细、每周执行 SQLite optimize。
HEALTH_MAINTENANCE_ENABLED=true

# 可信反向代理：逗号分隔的明确 IP/CIDR，或 proxy-addr 支持的
# loopback、linklocal、uniquelocal。留空时不信任 X-Forwarded-For 和国家头。
# Docker 网络内的 Nginx/Caddy 通常可使用 uniquelocal；公网代理建议填写官方 CIDR。
NAVPILOT_TRUST_PROXY=
# 可信代理可提供的国家代码头，按顺序读取。只有直连来源命中上面的可信代理时才会采用。
NAVPILOT_GEOIP_HEADERS=cf-ipcountry,x-country-code,x-vercel-ip-country
# 可选 MaxMind GeoLite2/GeoIP2 Country MMDB；请求头没有国家代码时按真实客户端 IP 查询。
# Docker Compose 已将 ./server/geoip 只读挂载到 /app/geoip。
NAVPILOT_GEOIP_DB_PATH=/app/geoip/GeoLite2-Country.mmdb
# 可选 City MMDB；允许标准 GeoIP2 City 或仅返回 city 字符串的兼容 MMDB
NAVPILOT_GEOIP_CITY_DB_PATH=/app/geoip/geolite2-city-ipv4.mmdb

# 当前版本不再使用 ADMIN_TOKEN，也不接受 x-user-id/x-user-name 身份头。
# 登录使用服务器端 SQLite 会话和 HttpOnly Cookie；生产环境必须使用 HTTPS。
